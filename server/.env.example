# -----------------------------------------------------------------------------
# Image Resizer API — environment template.
#
# Copy to `server/.env` for local development (that file is gitignored).
# In production these values come from AWS SSM Parameter Store and are rendered
# to /etc/image-resizer/env (mode 0640) at deploy time — never commit real values.
# Every variable is optional; defaults are shown. Invalid values stop the server
# at boot with the variable name (never its value) in the error.
# -----------------------------------------------------------------------------

# development | test | production  (production enables HSTS + upgrade-insecure-requests)
NODE_ENV=development

# Bind address. Keep 127.0.0.1 behind nginx; never expose Node directly.
HOST=127.0.0.1
PORT=8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs for local development only.
PRETTY_LOGS=true

# Number of proxy hops in front of Node, or "loopback". "true" is rejected
# because it lets clients spoof their IP and dodge rate limiting.
#   nginx only                        -> loopback
#   CloudFront -> ALB -> nginx -> Node -> 3
TRUST_PROXY=loopback

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the SPA and API share an origin (CloudFront /api/* routing).
CORS_ORIGINS=

# Shared secret CloudFront adds as the X-Origin-Verify header; requests without
# it are rejected so the origin cannot be hit directly. >= 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORIGIN_VERIFY_SECRET=
# Rotation only: the outgoing value, accepted alongside the new one until
# CloudFront has switched. See docs/DEPLOYMENT.md#rotating-the-origin-secret.
ORIGIN_VERIFY_SECRET_PREVIOUS=

# Serve the built SPA from this directory (single-host deployments / e2e).
# Unset when the SPA is hosted on S3 + CloudFront.
STATIC_DIR=

# ----------------------------------------------------------------- limits
MAX_UPLOAD_MB=25
# Decoded pixel budget per input — the decompression-bomb guard.
MAX_INPUT_PIXELS=50000000
MAX_OUTPUT_DIMENSION=10000
MAX_OUTPUT_PIXELS=50000000

# ------------------------------------------------------------- processing
# Concurrent encode jobs (default: half the vCPUs, 1–4). Each job may hold
# roughly MAX_INPUT_PIXELS x 4 bytes of RAM at peak.
PROCESSING_CONCURRENCY=2
# Jobs allowed to wait for a slot before the API sheds load with 503.
PROCESSING_QUEUE_LIMIT=16
PROCESSING_TIMEOUT_SECONDS=45

# Per-client limit on POST /images/process (per instance; use AWS WAF for a
# global limit across instances).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=30

# ----------------------------------------------------- feedback & reviews
# Where ratings/reviews are stored:
#   memory   - tests only (lost on restart)
#   file     - local development: FEEDBACK_FILE (gitignored .data/ folder)
#   dynamodb - production: FEEDBACK_TABLE + AWS_REGION (set automatically on EC2)
# Default: dynamodb in production, file in development, memory in tests.
FEEDBACK_STORE=
FEEDBACK_FILE=.data/feedback.json
FEEDBACK_TABLE=
# auto   - publish immediately; comments containing links, emails or phone
#          numbers wait for approval (spam protection)
# manual - every comment waits for approval in /admin
FEEDBACK_MODERATION=auto
# Feedback submissions allowed per visitor IP per hour.
FEEDBACK_RATE_LIMIT_MAX=5

# ------------------------------------------------------------- admin area
# Enables /admin (review moderation + show/hide the review wall). Leave both
# empty to disable it entirely. Generate both values with:
#   npm run admin:hash-password -w server
# The password itself is never stored — only this scrypt hash.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Sign-in lifetime in hours (1-168).
ADMIN_SESSION_HOURS=8

# -------------------------------------------------------------- temp files
# Private scratch root for uploads (created 0700). Each request gets its own
# directory, removed when the response closes; a janitor removes anything
# older than TEMP_MAX_AGE_SECONDS. Default: <os tmp>/imageresizer
TEMP_DIR=
TEMP_MAX_AGE_SECONDS=300
