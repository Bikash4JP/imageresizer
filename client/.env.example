# -----------------------------------------------------------------------------
# SPA build-time configuration. Copy to `client/.env.local` if needed.
#
# WARNING: every VITE_* variable is compiled into the public JavaScript bundle.
# Never put secrets here — only public URLs and feature flags.
# -----------------------------------------------------------------------------

# Leave empty for same-origin deployments (recommended: CloudFront routes /api/*
# to the API, and the Vite dev server proxies /api to localhost:8080).
# Set only for split-origin hosting, e.g. https://api.example.com — the API must
# then list this app's origin in CORS_ORIGINS.
VITE_API_BASE_URL=
